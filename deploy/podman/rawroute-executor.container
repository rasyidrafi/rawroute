[Unit]
Description=RawRoute Executor
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/usefulsoftwareco/executor-selfhost:latest
ContainerName=rawroute-executor
Network=rawroute.network
NetworkAlias=executor
EnvironmentFile=/etc/rawroute/executor.env
Volume=rawroute-executor.volume:/data
HealthCmd=bun -e "fetch('http://127.0.0.1:4788/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthOnFailure=kill
LogDriver=k8s-file
LogOpt=max-size=10mb

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45
MemoryMax=256M
MemorySwapMax=64M
TasksMax=128

# This unit is intentionally optional: it has no [Install] section and is not
# wanted by rawroute.service. Start rawroute-executor.service explicitly when
# EXECUTOR_UPSTREAM_API_KEY is configured in app.env.
