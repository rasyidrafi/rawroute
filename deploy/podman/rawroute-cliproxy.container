[Unit]
Description=RawRoute cliproxy
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/eceasy/cli-proxy-api:v7.3.4@sha256:97825da3009f98acf78b5c172fde650a5fbe7a690950a69ce6d7b535d77d4266
ContainerName=rawroute-cliproxy
Network=rawroute.network
NetworkAlias=cli-proxy-api
EnvironmentFile=/etc/rawroute/cliproxy.env
Environment=GOMEMLIMIT=80MiB
Environment=GOMAXPROCS=1
Volume=/etc/rawroute/cliproxy.yaml:/CLIProxyAPI/config.yaml
Volume=rawroute-cliproxy-auth.volume:/root/.cli-proxy-api
LogDriver=k8s-file
LogOpt=max-size=10mb

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45
MemoryMax=128M
MemorySwapMax=64M
TasksMax=128

[Install]
WantedBy=multi-user.target
