{
  "name": "rawroute",
  "version": "1.1.9",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun scripts/build.ts",
    "start": "NODE_ENV=production bun --cwd dist index.js",
    "lint": "bun --bun eslint --max-warnings=0 && CI=1 REACT_DOCTOR_DISABLE_OXLINT_WORKER_POOL=1 bun --bun react-doctor --lint --scope full --yes --no-score --blocking warning",
    "test": "bun test --isolate",
    "test:e2e": "bun run build && bunx --bun playwright test",
    "reconcile:usage": "bun scripts/reconcile-usage.ts",
    "predict:usage": "bun scripts/predict-missing-usage-cost.ts",
    "sanitize:usage": "bun scripts/sanitize-usage-integrity.ts",
    "delete:gateway-key-data": "bun scripts/delete-gateway-key-data.ts",
    "test:local-db": "bun scripts/local-db-smoke.ts",
    "backfill:api-key-indexes": "bun scripts/backfill-api-key-indexes.ts",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@legendapp/list": "^3.0.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.27.0",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "react-router": "^8.4.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@shadcn/lint": "^0.2.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun": "1.4.2",
    "bun-plugin-tailwind": "^0.1.2",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "react-doctor": "0.9.14",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "trustedDependencies": [
    "bun"
  ],
  "type": "module"
}
