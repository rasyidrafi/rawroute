{
  "name": "rawroute",
  "version": "1.1.9",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun --hot apps/console/src/server/index.ts",
    "build": "bun scripts/build.ts",
    "start": "NODE_ENV=production bun --cwd dist index.js",
    "lint": "bun run check:architecture && bun --bun eslint --max-warnings=0 && CI=1 REACT_DOCTOR_DISABLE_OXLINT_WORKER_POOL=1 bun --bun react-doctor . --lint --scope full --yes --no-score --blocking warning",
    "test": "bun test --isolate",
    "test:e2e": "bun run build && bunx --bun playwright test",
    "verify": "bun --no-env-file scripts/verify.ts",
    "migrate:usage": "bun --no-env-file scripts/migrations/usage-projection.ts",
    "predict:usage": "bun --no-env-file scripts/predict-missing-usage-cost.ts",
    "test:local-db": "bun tests/diagnostics/local-db-smoke.ts",
    "typecheck": "tsc-rs --fast --noEmit",
    "check:architecture": "bun --no-env-file scripts/check-architecture.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "proper-lockfile": "^4.1.2",
    "@playwright/test": "1.62.0",
    "@shadcn/lint": "^0.2.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^20",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun": "1.4.2",
    "bun-plugin-tailwind": "^0.1.2",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "react-doctor": "0.9.14",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "tsc-rs": "^0.7.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "@rawroute/platform": "workspace:*",
    "@rawroute/gateway-ai": "workspace:*",
    "@rawroute/gateway-tools": "workspace:*",
    "@rawroute/observability": "workspace:*",
    "@rawroute/ui": "workspace:*",
    "@rawroute/console": "workspace:*"
  },
  "trustedDependencies": [
    "bun"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
