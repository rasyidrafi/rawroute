# Optional deployment boundaries only. Docker Compose needs no environment file.
# RAWROUTE_HOST_PORT=8080
# RAWROUTE_DATA_DIR=/absolute/path/to/data
# TIMEZONE=UTC
# RAWROUTE_PUBLIC_URL=https://gateway.example.com
# RAWROUTE_ALLOWED_ORIGINS=https://dashboard.example.com
# Enable Storage with docker-compose.storage.yml, or for a native run:
# STORAGE_ENABLED=true
# Explicit trust exception for a private S3 provider (exact origins only):
# STORAGE_S3_ALLOWED_ORIGINS=https://private-s3.example:9443
# Optional externally owned Executor credentials:
# EXECUTOR_UPSTREAM_URL=http://executor:4788
# EXECUTOR_UPSTREAM_API_KEY=
