# RawRoute runtime and dashboard
STORAGE_BACKEND=firestore
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
DEFAULT_PROXY_API_KEY=sk-replace-with-a-gateway-key
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-encryption-key
TIMEZONE=Asia/Jakarta
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta

# RawRoute Firestore data: workspaces, gateway keys, budgets, pricing, aliases, and usage
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Preserve literal \n sequences when setting this environment variable.
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_PREFIX=rawroute
FIRESTORE_CHILD_READ_CONCURRENCY=16
FIRESTORE_ANALYTICS_READ_CONCURRENCY=8

# RawRoute retrieval caches only. CLIProxyAPI owns provider rate limits, retries, and routing.
WORKSPACE_CACHE_TTL_MS=60000
WORKSPACE_NEGATIVE_CACHE_TTL_MS=10000
MAX_WORKSPACE_CACHE_ENTRIES=256
BUDGET_CACHE_TTL_MS=60000
BUDGET_COUNTER_CACHE_TTL_MS=30000
DASHBOARD_CACHE_TTL_MS=30000
PRICING_CATALOG_CACHE_TTL_MS=60000
PRICING_ADMIN_CACHE_TTL_MS=5000
PRICING_JOBS_CACHE_TTL_MS=2000
CODEX_USAGE_LOCAL_CACHE_TTL_MS=300000
USAGE_ROLLUP_GRANULARITIES=hourly,daily

# RawRoute budget admission and usage estimation
BUDGET_DEFAULT_OUTPUT_TOKENS=4096
BUDGET_INPUT_BYTES_PER_TOKEN=3
BUDGET_RESERVATION_SAFETY_PERCENT=125

# Private CLIProxyAPI service; none of these values are sent to browsers.
CLIPROXY_URL=http://cli-proxy-api:8317
CLIPROXY_MANAGEMENT_KEY=replace-with-a-long-internal-management-key
CLIPROXY_API_KEY=replace-with-the-key-configured-in-cliproxy
RAWROUTE_PUBLIC_URL=http://localhost:8080
CLI_PROXY_IMAGE=eceasy/cli-proxy-api:latest

# Compose-mounted CLIProxyAPI state. The image itself is pulled from the registry.
CLI_PROXY_CONFIG_PATH=./cliproxy/config.yaml
CLI_PROXY_AUTH_PATH=./cliproxy/auths
CLI_PROXY_LOG_PATH=./cliproxy/logs
CLI_PROXY_PLUGIN_PATH=./cliproxy/plugins
