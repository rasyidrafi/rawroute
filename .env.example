GOOGLE_CLOUD_PROJECT=your-project-id
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIRESTORE_DATABASE_ID=ai-proxy
FIRESTORE_COLLECTION_PREFIX=rawroute
ROUTING_CACHE_TTL_MS=2000
MAX_PROXY_BODY_BYTES=10485760

# Required shared routing state for multi-instance Cloud Run deployments.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token
ROUTING_AFFINITY_TTL_SECONDS=3600
ROUTING_RESPONSE_TTL_SECONDS=86400
ROUTING_INFLIGHT_LEASE_TTL_SECONDS=900
ROUTING_MAX_REQUEST_DURATION_SECONDS=1800
ROUTING_DEFAULT_RPM_LIMIT=60
ROUTING_DEFAULT_MAX_CONCURRENCY=4
ROUTING_PROMPT_PREFIX_AFFINITY=false

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-private-password
DEFAULT_PROXY_API_KEY=replace-with-a-private-gateway-key
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Used to encrypt Codex OAuth access, refresh, and ID tokens in Firestore.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-at-least-32-byte-secret

# Optional Codex overrides for testing or a compatible upstream.
# CODEX_AUTH_BASE_URL=https://auth.openai.com
# CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# Alternative local setup using the Firestore emulator.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
