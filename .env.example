# Runtime and bootstrap
STORAGE_BACKEND=firestore
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_PROXY_API_KEY=
SESSION_SECRET=
# Optional separate key for OAuth credential encryption. SESSION_SECRET is used when omitted.
CREDENTIAL_ENCRYPTION_KEY=
TIMEZONE=Asia/Jakarta
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta

# Firestore
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Preserve literal \n sequences when setting this in an environment variable.
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_PREFIX=rawroute
FIRESTORE_CHILD_READ_CONCURRENCY=16
FIRESTORE_ANALYTICS_READ_CONCURRENCY=8

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# v2 uses one provider-scoped hash for RPM, concurrency leases, and cooldowns.
# Keep one routing version active during a deploy; changing this prefix resets
# transient affinity/response mappings and isolates capacity state.
ROUTING_STATE_PREFIX=rawroute:routing:v2
ROUTING_AFFINITY_TTL_SECONDS=3600
ROUTING_RESPONSE_TTL_SECONDS=86400
ROUTING_INFLIGHT_LEASE_TTL_SECONDS=900
ROUTING_STATE_TTL_SECONDS=604800
ROUTING_STATE_TOUCH_INTERVAL_SECONDS=86400
# False avoids an extra Redis write on every affinity hit. Enable only when
# sessions must remain sticky indefinitely while active.
ROUTING_REFRESH_AFFINITY_TTL=false
ROUTING_DEFAULT_RPM_LIMIT=60
ROUTING_DEFAULT_MAX_CONCURRENCY=4

# Bounded process-local caches. Increasing TTLs reduces database reads but delays
# cross-instance visibility; local admin mutations invalidate immediately.
ROUTING_CACHE_TTL_MS=60000
# Most expired routing snapshots validate with one revision-document read. This
# safety interval forces a complete reload even when an older deployment did
# not update the revision marker.
ROUTING_FULL_REFRESH_INTERVAL_MS=900000
API_KEY_CACHE_TTL_MS=60000
API_KEY_NEGATIVE_CACHE_TTL_MS=10000
# Leave disabled after running the one-time index backfill. Enabling this makes
# an index miss scan workspaces and should be temporary migration/repair only.
API_KEY_INDEX_REPAIR_ON_MISS=false
WORKSPACE_CACHE_TTL_MS=60000
WORKSPACE_NEGATIVE_CACHE_TTL_MS=10000
MAX_WORKSPACE_CACHE_ENTRIES=256
MAX_PROVIDER_SCOPED_CACHE_ENTRIES=256
BUDGET_CACHE_TTL_MS=60000
BUDGET_COUNTER_CACHE_TTL_MS=30000
DASHBOARD_CACHE_TTL_MS=30000
# Protect dashboard reads and response construction from pathological ranges.
# Longer requested granularities are automatically coarsened to keep chart
# bucket counts bounded. The public dashboard additionally caps custom ranges
# at the separate public limit below.
DASHBOARD_MAX_CUSTOM_RANGE_DAYS=3650
PUBLIC_DASHBOARD_MAX_CUSTOM_RANGE_DAYS=366
DASHBOARD_MAX_HOURLY_RANGE_DAYS=31
DASHBOARD_MAX_DAILY_RANGE_DAYS=730
DASHBOARD_MAX_WEEKLY_RANGE_DAYS=7300
PRICING_CATALOG_CACHE_TTL_MS=60000
PRICING_ADMIN_CACHE_TTL_MS=5000
PRICING_JOBS_CACHE_TTL_MS=2000
CODEX_USAGE_LOCAL_CACHE_TTL_MS=300000
# Hourly + daily minimizes request-time writes while bounding dashboard reads.
# Add monthly only when measured long-range dashboard read volume justifies one
# additional Firestore write per completed request.
USAGE_ROLLUP_GRANULARITIES=hourly,daily

# Proxy limits
MAX_PROXY_BODY_BYTES=10485760
ROUTING_MAX_STREAM_DURATION_SECONDS=290
ROUTING_MAX_NON_STREAM_DURATION_SECONDS=60
ROUTING_PROMPT_PREFIX_AFFINITY=false

# Conservative budget reservation estimate for requests without a strict output cap
BUDGET_DEFAULT_OUTPUT_TOKENS=
BUDGET_INPUT_BYTES_PER_TOKEN=
BUDGET_RESERVATION_SAFETY_PERCENT=125

# Optional Codex overrides
CODEX_AUTH_BASE_URL=https://auth.openai.com
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
CODEX_FEDRAMP=false
